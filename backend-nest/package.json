{
  "name": "backend-nest",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "test": "jest"
  },
  "packageManager": "yarn@4.13.0",
  "volta": {
    "node": "24.14.1",
    "yarn": "4.13.0"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/typeorm": "^11",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "express": "^5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.0"
  }
}
